<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.johnmontero.move-temp-recordings</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/john.montero/development/tools/mac-scripts/shortcuts/move-temp-recordings.sh</string>
    </array>

    <!-- Se ejecuta todos los días a las 08:55, antes de la limpieza de Temp -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>55</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/john.montero/Library/Logs/move-temp-recordings.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/john.montero/Library/Logs/move-temp-recordings.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
